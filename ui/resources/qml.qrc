<RCC>
    <qresource prefix="/qml">
        <file>../qml/main.qml</file>
        <file>../qml/DarkTheme.qml</file>
        <file>../qml/LightTheme.qml</file>
        <file>../qml/SLDCanvas.qml</file>
        <file>../qml/BusComponent.qml</file>
        <file>../qml/LineComponent.qml</file>
        <file>../qml/GeneratorComponent.qml</file>
        <file>../qml/LoadComponent.qml</file>
        <file>../qml/TransformerComponent.qml</file>
        <file>../qml/Toolbar.qml</file>
        <file>../qml/PropertiesPanel.qml</file>
    </qresource>
    <qresource prefix="/fonts">
        <!-- SF Pro fonts would be placed here if bundled -->
        <!-- Using system fonts as fallback (see main.cpp) -->
    </qresource>
    <qresource prefix="/icons">
        <!-- Icons can be added here -->
    </qresource>
</RCC>
