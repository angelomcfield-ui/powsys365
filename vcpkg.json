{
  "name": "powsys365",
  "version": "1.0.0",
  "description": "Power System Analysis Platform",
  "license": "MPL-2.0",
  "dependencies": [
    {
      "name": "eigen3",
      "version>=": "3.4.0"
    },
    {
      "name": "nlohmann-json",
      "version>=": "3.11.0"
    },
    {
      "name": "catch2",
      "version>=": "3.7.0"
    },
    {
      "name": "libpq",
      "platform": "!osx"
    },
    {
      "name": "zlib",
      "version>=": "1.3.0"
    }
  ],
  "features": {
    "ui": {
      "description": "Build Qt6 GUI application",
      "dependencies": [
        {
          "name": "qtbase",
          "version>=": "6.5.0",
          "features": ["widgets", "gui", "network", "sql"]
        },
        {
          "name": "qtdeclarative",
          "version>=": "6.5.0"
        },
        {
          "name": "qtcharts",
          "version>=": "6.5.0"
        },
        {
          "name": "qtwebengine",
          "version>=": "6.5.0"
        }
      ]
    },
    "simulation": {
      "description": "Build transient simulation engine",
      "dependencies": [
        {
          "name": "sundials",
          "version>=": "6.7.0"
        }
      ]
    },
    "scada": {
      "description": "Build SCADA protocol libraries",
      "dependencies": [
        "openssl"
      ]
    }
  }
}
